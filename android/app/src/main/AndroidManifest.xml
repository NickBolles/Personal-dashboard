<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".JarvisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Jarvis">

        <!-- Digital Asset Links: the app's side of the site ↔ app link (the site serves /.well-known/assetlinks.json). -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <!--
          Launcher: the Jarvis web app full screen in Chrome (Trusted Web Activity). Widgets, the tile,
          shortcuts and notifications open their pages here (web/WebLinks.kt maps the old native links).
          Not singleTask: androidbrowserhelper keeps one task itself and navigates the running app.
        -->
        <activity
            android:name=".web.TwaLauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Jarvis.Launcher">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="${jarvisDefaultUrl}" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:resource="@color/brand" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK" android:resource="@color/dark_background" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:resource="@color/window_background" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK" android:resource="@color/dark_background" />
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- In-app links from widgets, the tile, shortcuts, notifications: jarvis://open/<path>, jarvis://areas/<id> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvis" android:host="open" />
                <data android:scheme="jarvis" android:host="areas" />
            </intent-filter>
            <!-- App Links: Jarvis links elsewhere on the phone open the app (verified by the site's assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${jarvisHost}" />
            </intent-filter>
        </activity>

        <!--
          Classic native screens, kept for one release behind the hidden "Classic app" shortcut
          (long-press the icon) as a fallback. Also handles pairing links and shared text.
          Own task so it never stacks on the web app.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/classic_app"
            android:launchMode="singleTop"
            android:taskAffinity="com.nickbolles.jarvis.classic"
            android:windowSoftInputMode="adjustResize">
            <!-- Pairing QR: jarvis://pair?server=…&code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvis" android:host="pair" />
            </intent-filter>
            <!-- Share text or a link to Jarvis → Ask Hermes with it -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widgets.NextUpConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Jarvis">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service android:name=".push.JarvisMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver android:name=".push.NotificationActionReceiver" android:exported="false" />

        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_jarvis"
            android:label="@string/tile_capture"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver android:name=".widgets.NextUpWidgetReceiver" android:exported="true" android:label="@string/widget_next_up">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_up" />
        </receiver>
        <receiver android:name=".widgets.HomeStatusWidgetReceiver" android:exported="true" android:label="@string/widget_home_status">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_home_status" />
        </receiver>
        <receiver android:name=".widgets.CaptureWidgetReceiver" android:exported="true" android:label="@string/widget_capture">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_capture" />
        </receiver>
        <receiver android:name=".widgets.CompassWidgetReceiver" android:exported="true" android:label="@string/widget_compass">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_compass" />
        </receiver>
        <receiver android:name=".widgets.AreasNextWidgetReceiver" android:exported="true" android:label="@string/widget_areas_next">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_areas_next" />
        </receiver>
    </application>
</manifest>
