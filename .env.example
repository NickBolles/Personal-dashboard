# --- Jarvis (copy to .env) ---
JARVIS_DOMAIN=jarvis.example.com
TZ=America/Chicago

# Auth: "local" (passcode, default) or "proxy" (trust an authenticating reverse proxy)
JARVIS_AUTH_MODE=local
# Proxy mode requires authenticating middleware that strips spoofed identity headers.
# The default jarvis-headers middleware is NOT authentication. See docs/security.md.
# proxy mode only:
# JARVIS_AUTH_PROXY_HEADER=remote-user
# JARVIS_AUTH_PROXY_USERS=nick

# Optional fixed setup code (otherwise a random one is printed in the logs on first boot)
# JARVIS_SETUP_CODE=

# Encryption key for integration secrets (32 bytes base64). If unset, /data/secret.key is generated.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# JARVIS_SECRET_KEY=

# Web Push contact (must be a real mailto: or https: URL)
JARVIS_VAPID_SUBJECT=mailto:you@example.com

# Traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge
# Proxy auth example ONLY after the middleware exists and is tested:
# TRAEFIK_MIDDLEWARES=your-auth@file,jarvis-headers

# --- Integrations: optional env overrides (otherwise configure in the app) ---
# HERMES_BASE_URL=http://hermes:8642
# HERMES_API_KEY=
# HERMES_DASHBOARD_URL=https://hermes.example.com
# HA_BASE_URL=http://192.168.1.249:8123
# HA_TOKEN=
# PAPERCLIP_BASE_URL=http://paperclip:3100
# PAPERCLIP_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SKYLIGHT_REFRESH_TOKEN=

# Optional Android TWA wrapper: package=sha256 fingerprints
# Android app (Trusted Web Activity) Digital Asset Links at /.well-known/assetlinks.json.
# Default: com.nickbolles.jarvis + the persistent CI signing key. Override with a comma list, or "none".
# JARVIS_ANDROID_CERT_SHA256=8D:60:31:...
# JARVIS_ANDROID_PACKAGE=com.nickbolles.jarvis
# More apps (older format, still honoured):
# JARVIS_TWA_ASSETLINKS=com.example.app=AA:BB:CC:...

# Optional Work hub PR refresh: read-only GitHub token (fine-grained, Pull requests: read).
# Without it, PR state is set manually (Mark merged / Mark closed).
# JARVIS_GITHUB_TOKEN=
